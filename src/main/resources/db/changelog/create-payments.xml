<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-4.0.xsd">

    <changeSet id="create-payments-collection" author="dev">
        <mongodb:createCollection collectionName="payments"/>
    </changeSet>

    <changeSet id="payments-indexes" author="dev">

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { "order_id": 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_order_id" }
            </mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { "user_id": 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_user_id" }
            </mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { "status": 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_status" }
            </mongodb:options>
        </mongodb:createIndex>

    </changeSet>

</databaseChangeLog>